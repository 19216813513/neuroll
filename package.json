{
  "name": "neuroll",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "fix": "biome check --write src",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "deploy:preview": "npm run build && wrangler versions upload",
    "cf:whoami": "wrangler whoami",
    "cf:login": "wrangler login",
    "cf:tail": "wrangler tail"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "preact": "^10.27.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.42.0"
  }
}
